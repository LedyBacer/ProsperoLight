+
+/* A deferred packet must first pass the same inexpensive admission gates as
+ * the real RTP/FEC queue. Otherwise stale sequence numbers or inconsistent
+ * FEC headers can occupy the entire bounded hold window before rejection.
+ * Leave all actual FEC decoding and duplicate detection to RtpvAddPacket(). */
+static bool reorderStagingEligible(uint16_t sequence, uint16_t nextSequence,
+                                   bool hasExtension, uint32_t fecInfo,
+                                   uint8_t multiFecBlocks, bool multiFecCapable) {
+    if (!hasExtension || isBefore16(sequence, nextSequence)) return false;
+    uint32_t data = (fecInfo & 0xFFC00000) >> 22;
+    uint32_t percentage = (fecInfo & 0xFF0) >> 4;
+    uint32_t index = (fecInfo & 0x3FF000) >> 12;
+    uint32_t parity = (data * percentage + 99) / 100;
+    if (!data || index >= data + parity) return false;
+    return !multiFecCapable ||
+           ((multiFecBlocks >> 4) & 3) <= ((multiFecBlocks >> 6) & 3);
+}
 
