+// Diagnostic accounting only. Measurements never control RTP recovery.
+#define LI_VIDEO_REORDER_STATS_VERSION 1
+typedef struct _LI_VIDEO_REORDER_STATS {
+    uint64_t late_packets_accepted;
+    uint64_t late_packets_rejected;
+    uint64_t reorder_wait_total_us; // sum of time held per datagram
+    uint64_t reorder_wait_max_us;
+    uint64_t reorder_timeouts;
+    uint64_t fec_recovered_after_reorder; // parity-recovered data shards
+    uint64_t rescued_frames; // completed while future FEC packets were held
+    uint64_t held_packets;
+    uint64_t capacity_flushes;
+} LI_VIDEO_REORDER_STATS;
