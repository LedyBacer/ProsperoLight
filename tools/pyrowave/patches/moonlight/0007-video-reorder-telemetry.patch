+       RV_TIMEOUTS, RV_FEC_RECOVERED, RV_RESCUED, RV_HELD, RV_CAPACITY, RV_COUNT };
+static _Atomic uint64_t reorderCounters[RV_COUNT];
+static uint32_t reorderRescueFrame;
+static uint32_t reorderRescueFecFailures;
+static uint32_t reorderLastTimeoutFrame;
+static uint8_t reorderLastTimeoutBlock;
+#define REORDER_INC(key) atomic_fetch_add_explicit(&reorderCounters[RV_##key], 1, memory_order_relaxed)
+#define REORDER_ADD(key, n) atomic_fetch_add_explicit(&reorderCounters[RV_##key], (n), memory_order_relaxed)
+
+static void reorderObserveWait(uint64_t waitUs) {
+    REORDER_ADD(WAIT_TOTAL, waitUs);
+    uint64_t maximum = atomic_load_explicit(&reorderCounters[RV_WAIT_MAX], memory_order_relaxed);
+    while (waitUs > maximum &&
+           !atomic_compare_exchange_weak_explicit(&reorderCounters[RV_WAIT_MAX],
+                                                  &maximum, waitUs,
+                                                  memory_order_relaxed, memory_order_relaxed)) {
+    }
+}
+
+bool LiGetVideoReorderStats(LI_VIDEO_REORDER_STATS* stats) {
+    if (stats == NULL) return false;
+    stats->late_packets_accepted = atomic_load_explicit(&reorderCounters[RV_LATE_ACCEPTED], memory_order_relaxed);
+    stats->late_packets_rejected = atomic_load_explicit(&reorderCounters[RV_LATE_REJECTED], memory_order_relaxed);
+    stats->reorder_wait_total_us = atomic_load_explicit(&reorderCounters[RV_WAIT_TOTAL], memory_order_relaxed);
+    stats->reorder_wait_max_us = atomic_load_explicit(&reorderCounters[RV_WAIT_MAX], memory_order_relaxed);
+    stats->reorder_timeouts = atomic_load_explicit(&reorderCounters[RV_TIMEOUTS], memory_order_relaxed);
+    stats->fec_recovered_after_reorder = atomic_load_explicit(&reorderCounters[RV_FEC_RECOVERED], memory_order_relaxed);
+    stats->rescued_frames = atomic_load_explicit(&reorderCounters[RV_RESCUED], memory_order_relaxed);
+    stats->held_packets = atomic_load_explicit(&reorderCounters[RV_HELD], memory_order_relaxed);
+    stats->capacity_flushes = atomic_load_explicit(&reorderCounters[RV_CAPACITY], memory_order_relaxed);
+    return true;
+}
+
+static void reorderFrameAdvanced(uint32_t previousFrame) {
+    if (rtpQueue.currentFrameNumber != previousFrame && reorderRescueFrame == previousFrame) {
+        if (rtpQueue.stats.packetCountFecFailed == reorderRescueFecFailures) {
+            REORDER_INC(RESCUED);
+        }
+        reorderRescueFrame = 0;
+    }
+}
