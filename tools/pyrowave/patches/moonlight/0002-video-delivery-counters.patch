 #include "Limelight-internal.h"
 
+#include <stdatomic.h>
+// Session-scoped, allocation-free diagnostics. No transport decisions depend on these.
+enum { VD_COMPLETED_FRAME_EVENTS, VD_RECOVERY_FILTERED_AUS, VD_EMPTY_AUS, VD_VIDEO_PACKETS, VD_VIDEO_BYTES, VD_ASSEMBLED_AUS, VD_OFFERED_AUS, VD_QUEUE_ACCEPTED_AUS, VD_DEQUEUED_AUS, VD_OVERFLOW_DISCARDED_AUS, VD_REFRESH_DISCARDED_AUS, VD_SHUTDOWN_DISCARDED_AUS, VD_INTERRUPTED_DISCARDED_AUS, VD_ALLOCATION_DISCARDED_AUS, VD_COUNT };
+static _Atomic uint64_t delivery[VD_COUNT];
+static _Atomic uint64_t deliveryStartUs, deliveryEndUs;
+static _Atomic bool deliveryDirect;
+#define VD_ADD(field, value) atomic_fetch_add_explicit(&delivery[VD_##field], (value), memory_order_relaxed)
+void notifyVideoDatagramReceived(unsigned int bytes) {
+    VD_ADD(VIDEO_PACKETS, 1);
+    VD_ADD(VIDEO_BYTES, bytes);
+}
+bool LiGetVideoDeliveryStats(LI_VIDEO_DELIVERY_STATS* stats) {
+    if (stats == NULL) return false;
+    stats->start_us = atomic_load_explicit(&deliveryStartUs, memory_order_relaxed);
+    stats->end_us = atomic_load_explicit(&deliveryEndUs, memory_order_relaxed);
+    stats->video_packets = atomic_load_explicit(&delivery[VD_VIDEO_PACKETS], memory_order_relaxed);
+    stats->video_bytes = atomic_load_explicit(&delivery[VD_VIDEO_BYTES], memory_order_relaxed);
+    stats->completed_frame_events = atomic_load_explicit(&delivery[VD_COMPLETED_FRAME_EVENTS], memory_order_relaxed);
+    stats->recovery_filtered_aus = atomic_load_explicit(&delivery[VD_RECOVERY_FILTERED_AUS], memory_order_relaxed);
+    stats->empty_aus = atomic_load_explicit(&delivery[VD_EMPTY_AUS], memory_order_relaxed);
+    stats->assembled_aus = atomic_load_explicit(&delivery[VD_ASSEMBLED_AUS], memory_order_relaxed);
+    stats->offered_aus = atomic_load_explicit(&delivery[VD_OFFERED_AUS], memory_order_relaxed);
+    stats->queue_accepted_aus = atomic_load_explicit(&delivery[VD_QUEUE_ACCEPTED_AUS], memory_order_relaxed);
+    stats->dequeued_aus = atomic_load_explicit(&delivery[VD_DEQUEUED_AUS], memory_order_relaxed);
+    stats->overflow_discarded_aus = atomic_load_explicit(&delivery[VD_OVERFLOW_DISCARDED_AUS], memory_order_relaxed);
+    stats->refresh_discarded_aus = atomic_load_explicit(&delivery[VD_REFRESH_DISCARDED_AUS], memory_order_relaxed);
+    stats->shutdown_discarded_aus = atomic_load_explicit(&delivery[VD_SHUTDOWN_DISCARDED_AUS], memory_order_relaxed);
+    stats->interrupted_discarded_aus = atomic_load_explicit(&delivery[VD_INTERRUPTED_DISCARDED_AUS], memory_order_relaxed);
+    stats->allocation_discarded_aus = atomic_load_explicit(&delivery[VD_ALLOCATION_DISCARDED_AUS], memory_order_relaxed);
+    stats->direct_submit = atomic_load_explicit(&deliveryDirect, memory_order_relaxed);
+    return stats->start_us != 0;
+}
