+        PRTPV_QUEUE_ENTRY lostEntry = (PRTPV_QUEUE_ENTRY)&buffer[receiveSize];
+        lostEntry->packet = rtpPacket;
+        lostEntry->length = StreamConfig.packetSize + dataOffset;
