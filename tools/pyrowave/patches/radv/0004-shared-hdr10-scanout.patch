+
+/* Application selects scanout semantics before creating a display surface.
+ * Uses the same verified VideoOut format and HSYNC flip mode as VideoDec2.
+ */
+int wsi_ps5_configure_output(int hdr, int vsync, int high_refresh);
+int wsi_ps5_configure_output(int hdr, int vsync, int high_refresh)
+{
+   call_once(&videoout_once, videoout_output_init_once);
+   struct wsi_videoout_output *out = &videoout_output;
+   mtx_lock(&out->lock);
+   if (out->buffers || out->current || out->queue_count) {
+      mtx_unlock(&out->lock);
+      return -1;
+   }
+   out->hdr = hdr != 0;
+   out->prefer_high_refresh = high_refresh != 0;
+   out->flip_mode = vsync ? 1u : 2u;
+   mtx_unlock(&out->lock);
+   return 0;
+}
