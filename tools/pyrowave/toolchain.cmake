set(CMAKE_SYSTEM_NAME FreeBSD)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(NOT DEFINED ENV{PS5_PAYLOAD_SDK} OR NOT DEFINED ENV{PS5_VULKAN_ROOT})
    message(FATAL_ERROR "PS5_PAYLOAD_SDK and PS5_VULKAN_ROOT must name the pinned SDK and PS5_Vulkan")
endif()
set(CMAKE_C_COMPILER "${CMAKE_CURRENT_LIST_DIR}/ps5-cc.sh")
set(CMAKE_CXX_COMPILER "${CMAKE_CURRENT_LIST_DIR}/ps5-cc.sh")
set(CMAKE_AR "$ENV{PS5_PAYLOAD_SDK}/bin/prospero-ar")
set(CMAKE_RANLIB "$ENV{PS5_PAYLOAD_SDK}/bin/prospero-ranlib")
set(CMAKE_C_FLAGS_INIT "-O2 -ffunction-sections -fdata-sections -fvisibility=hidden")
set(CMAKE_CXX_FLAGS_INIT "-O2 -ffunction-sections -fdata-sections -fvisibility=hidden")
set(CMAKE_FIND_ROOT_PATH "$ENV{PS5_PAYLOAD_SDK}/target")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
