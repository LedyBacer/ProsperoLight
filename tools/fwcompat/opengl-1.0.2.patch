+/* FWCompat: normal call sites only; never probe defaults before AGC init. */
+extern void fwcompat_checkpoint(const char *, long long);
+extern void fwcompat_gpu_failure(void);
+#include <stdatomic.h>
+static atomic_uint fwcompat_agc_init_calls;
+static int fwcompat_agc_init(int (*fn)(uint32_t), uint32_t version)
+{
+    fwcompat_checkpoint("agc.init.call_number", atomic_fetch_add(&fwcompat_agc_init_calls, 1) + 1);
+    fwcompat_checkpoint("agc.init.begin", version);
+    int rc = fn(version);
+    fwcompat_checkpoint("agc.init.end", rc);
+    if (rc != 0) fwcompat_gpu_failure();
+    return rc;
+}
+static void *fwcompat_agc_defaults(void *(*fn)(void))
+{
+    static atomic_uint calls;
+    const int trace = atomic_fetch_add(&calls, 1) < 16;
+    if (trace) fwcompat_checkpoint("agc.defaults.begin", (long long)(uintptr_t)fn);
+    void *result = fn();
+    if (trace || !result) fwcompat_checkpoint("agc.defaults.end", (long long)(uintptr_t)result);
+    if (!result) fwcompat_gpu_failure();
+    return result;
+}
 
