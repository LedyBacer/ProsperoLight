+/* FWCompat round 2: only the explicitly selected app invokes these hooks.
+ * Share the runtime's real state; never retry a failed init or change its ABI. */
+#ifdef AGC_RUNTIME_PACKAGES
+static int fwcompat_early_initialized;
+int ps5_agc_fwcompat_early_init(void)
+{
+    agc_api_t agc = {0};
+    video_api_t video = {0};
+    if (runtime_agc_initialized ||
+        load_apis(NULL, NULL, NULL, &agc, &video) != 0) {
+        fwcompat_checkpoint("agc.early.state_or_api_error", -1);
+        fwcompat_gpu_failure();
+        return -1;
+    }
+    int rc = fwcompat_agc_init(agc.init, 8);
+    if (rc != 0) return rc;
+    runtime_agc_initialized = 1;
+    fwcompat_early_initialized = 1;
+    void *defaults = fwcompat_agc_defaults(agc.get_defaults);
+    fwcompat_checkpoint("agc.early.defaults", (long long)(uintptr_t)defaults);
+    return 0;
+}
+void ps5_agc_fwcompat_after_warmup(void)
+{
+    agc_api_t agc = {0};
+    video_api_t video = {0};
+    if (!fwcompat_early_initialized ||
+        load_apis(NULL, NULL, NULL, &agc, &video) != 0) {
+        fwcompat_checkpoint("agc.after_warmup.state_or_api_error", -1);
+        fwcompat_gpu_failure();
+        return;
+    }
+    void *defaults = fwcompat_agc_defaults(agc.get_defaults);
+    fwcompat_checkpoint("agc.after_warmup.defaults", (long long)(uintptr_t)defaults);
+}
+/* Snapshot getter only: no init, version change, dereference or recovery.
+ * Continue the remaining selected queries even after NULL; sticky failure
+ * prevents rendering afterwards. This variant measures observer effects too. */
+void ps5_agc_fwcompat_query_snapshot(unsigned index)
+{
+    static const char *const stages[] = {
+        "agc.after_query.compute", "agc.after_query.h264_sdr",
+        "agc.after_query.hevc_sdr", "agc.after_query.hevc_main10_hdr"
+    };
+    if (index >= 4) return;
+    agc_api_t agc = {0};
+    video_api_t video = {0};
+    if (!fwcompat_early_initialized ||
+        load_apis(NULL, NULL, NULL, &agc, &video) != 0) {
+        fwcompat_checkpoint("agc.snapshot.state_or_api_error", -1);
+        fwcompat_gpu_failure();
+        return;
+    }
+    void *defaults = fwcompat_agc_defaults(agc.get_defaults);
+    fwcompat_checkpoint(stages[index], (long long)(uintptr_t)defaults);
+}
+#endif
